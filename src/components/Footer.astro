---
// Footer - light footer with the logo, section links and the visit details
import { SITE } from '@/config/site';
---

<footer class="border-t border-border bg-surface text-foreground" data-ps="src/components/Footer.astro:ikmf33">
  <div class="mx-auto max-w-7xl px-6 py-12 md:px-8" data-ps="src/components/Footer.astro:p4vf88">
    <div class="grid gap-10 md:grid-cols-3" data-ps="src/components/Footer.astro:p4vf89">
      <div class="md:pr-0 md:border-[10px] md:border-[px] md:w-[107px] md:border-0 border-surface" data-ps="src/components/Footer.astro:p4vf8a">
        <a href="/" class="inline-block" data-ps="src/components/Footer.astro:7gqc0h">
          <img src="https://pagesmith-cdn.com/241cb74f/images/Colour_Copier_Logo-2.jpg-1-removebg-preview-DsbteiEd8TT1jvuNzTXULw-06c97e-612.webp" alt="Colour Copier Sdn Bhd" width="84" height="56" loading="lazy" class="h-14 w-auto" data-ps="src/components/Footer.astro:4qdjf2">
        </a>
      </div>

      <nav class="md:mr-[5px] md:w-[244px] md:pt-0 md:pr-4 md:mt-0.5 md:ml-[-294px]" aria-label="Footer" data-ps="src/components/Footer.astro:dr9u8d">
        <ul class="m-0 flex list-none flex-row flex-wrap gap-x-6 gap-y-3 p-0">
          <li data-ps="src/components/Footer.astro:wyji7a"><a href="/#about" class="text-base text-foreground underline-offset-4 transition-colors hover:text-secondary hover:underline" data-ps="src/components/Footer.astro:7gqc0i">About</a></li>
          <li data-ps="src/components/Footer.astro:wyji7b"><a href="/#services" class="text-base text-foreground underline-offset-4 transition-colors hover:text-secondary hover:underline" data-ps="src/components/Footer.astro:7gqc0j">Services</a></li>
          <li data-ps="src/components/Footer.astro:wyji7c"><a href="/#contact" class="text-base text-foreground underline-offset-4 transition-colors hover:text-secondary hover:underline" data-ps="src/components/Footer.astro:7gqc0k">Contact</a></li>
        </ul>
      </nav>

      <div class="flex flex-col gap-3 text-base text-muted-foreground" data-ps="src/components/Footer.astro:p4vf8b">
        <p data-ps="src/components/Footer.astro:euok">No.19, Jalan SP 3/1, Saujana Puchong, 47110 Puchong, Selangor Darul Ehsan, Malaysia.</p>
        <p data-ps="src/components/Footer.astro:euol"><a href="tel:0192250038" class="text-foreground underline-offset-4 hover:underline" data-ps="src/components/Footer.astro:7gqc0l">Contact : 019 225 0038</a></p>
        <p data-ps="src/components/Footer.astro:euom"><a href="mailto:kenny@icosmos.com.my" class="break-all text-foreground underline-offset-4 hover:underline" data-ps="src/components/Footer.astro:7gqc0m">Email : kenny@icosmos.com.my</a></p>
      </div>
    </div>

    <p class="mt-10 border-t border-border pt-8 text-sm text-muted-foreground" data-ps="src/components/Footer.astro:euon">COLOUR COPIER SDN BHD. All rights reserved</p>
  </div>
</footer>
